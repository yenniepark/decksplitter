{
  "name": "decksplitter",
  "version": "1.0.0",
  "private": true,
  "description": "브라우저에서만 동작하는 .pptx 분해기 (서버 전송 없음)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "check:offline": "node scripts/check-offline.mjs",
    "verify": "npm run typecheck && npm test && vite build && npm run check:offline"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
